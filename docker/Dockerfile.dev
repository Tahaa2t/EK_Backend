# Development Dockerfile
FROM node:20-alpine

# Install bash
RUN apk add --no-cache bash

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Expose backend port
EXPOSE 3000

# Set bash as default shell
SHELL ["/bin/bash", "-c"]

# Start the development server with nodemon
CMD ["/bin/bash", "-c", "npm run dev"]

